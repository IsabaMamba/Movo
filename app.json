{
  "expo": {
    "name": "Movo",
    "slug": "movo",
    "scheme": "movo",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "cr.movo.app"
    },
    "android": {
      "package": "cr.movo.app",
      "edgeToEdgeEnabled": true,
      "blockedPermissions": ["android.permission.ACCESS_FINE_LOCATION"],
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.POST_NOTIFICATIONS"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-font",
      "expo-splash-screen",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Movo usa tu ubicación aproximada para sugerirte actividades cerca. Solo guarda tu distrito."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
