{
  "expo": {
    "name": "Movo",
    "slug": "movo",
    "scheme": "movo",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "cr.movo.app"
    },
    "android": {
      "package": "cr.movo.app",
      "edgeToEdgeEnabled": true,
      "blockedPermissions": ["android.permission.ACCESS_FINE_LOCATION"]
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-font",
      "expo-splash-screen",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Movo usa tu ubicación aproximada, solo cuando tocas «Cerca de mí», para mostrarte sesiones cerca. No la guarda."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
