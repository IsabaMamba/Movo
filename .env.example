# Supabase project credentials.
# The anon key is a PUBLIC key — it is safe in a client bundle because
# row-level security, not secrecy, is what protects the data.
# The service-role key bypasses RLS entirely: never put it in this app.
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Web Push (docs/adr/0007). The PUBLIC half of a VAPID key pair; the private
# half goes only to the send-push Edge Function as a secret. Leave empty and
# the notification switch in /avisos does not appear.
#   npx web-push generate-vapid-keys
EXPO_PUBLIC_VAPID_PUBLIC_KEY=

# Origin used to build group invitation links (/g/CODE) outside the web,
# where the app does not know its own address. Leave empty until the domain
# is chosen; the web build uses its own origin.
EXPO_PUBLIC_SITE_URL=
