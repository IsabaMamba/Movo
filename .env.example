# Supabase project credentials.
# The anon key is a PUBLIC key — it is safe in a client bundle because
# row-level security, not secrecy, is what protects the data.
# The service-role key bypasses RLS entirely: never put it in this app.
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Map tiles (Mapbox free tier).
EXPO_PUBLIC_MAPBOX_TOKEN=pk.your-public-token
