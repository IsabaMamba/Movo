{
  "name": "movo",
  "version": "0.1.0",
  "private": true,
  "description": "Movo — group activity discovery for Costa Rica",
  "license": "SEE LICENSE IN LICENSE",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:reset": "supabase db reset",
    "db:push": "supabase db push",
    "db:test": "./scripts/db-test.sh",
    "verify": "npm run format:check && npm run lint && npm run typecheck"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.4.0",
    "eslint": "^10.9.1",
    "prettier": "^3.3.3",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.11.0"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.0"
  }
}
